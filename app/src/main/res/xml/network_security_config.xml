<?xml version="1.0" encoding="utf-8"?>
<!--
  Forces cleartext traffic off everywhere. All AI, search, and image
  provider API keys live on the backend server, never in this app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
